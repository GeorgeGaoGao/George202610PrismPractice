<Window x:Class="George202610PrismPractice.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/" xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}" Height="350" Width="525" >
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ItemsControl ItemsSource="{Binding Menus}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding MenuTitle}" 
                            CommandParameter="{Binding ViewName}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="5"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!--<StackPanel>-->

        <!--<Button Content="Home" Command="{Binding NavigateCommand}" CommandParameter="HomeView" Margin="5"/>   
            <Button Content="Login" Command="{Binding NavigateCommand}" CommandParameter="LoginView" Margin="5"/>-->
        <!--</StackPanel>-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Content="点击弹出对话框" Width="200" Height="40" Command="{Binding OpenDialogCommand}"/>
            <ContentControl Grid.Row="1" prism:RegionManager.RegionName="ContentRegion" />
        </Grid>
        
    </Grid>
</Window>
